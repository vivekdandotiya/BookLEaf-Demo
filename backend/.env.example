# Server Environment
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local)
# Atlas ReplicaSet / SRV URI Example:
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/bookleaf_support?retryWrites=true&w=majority
# Local Development Fallback:
# MONGODB_URI=mongodb://127.0.0.1:27017/bookleaf_db

# JWT Security
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# CORS & Allowed Clients (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173

# OpenAI API Configuration (Server-Side Only)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
